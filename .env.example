# Copie para .env.local e preencha. Nada aqui é obrigatório para `pnpm build`:
# sem a API, as páginas mostram um aviso de "dados indisponíveis".

# URL base do energia-api (sem barra no fim). Usada só no servidor.
API_URL=http://localhost:8000

# URL pública do portal (canonical, Open Graph, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo compartilhado com o energia-api para POST /api/revalidar
# (cabeçalho x-revalidate-secret). Gere com: openssl rand -hex 32
REVALIDATE_SECRET=

# Mesmo valor de WEB_API_SECRET no energia-api. Com ele, o servidor envia o IP do
# visitante (X-Cliente-IP) e o limite da newsletter vale por visitante, não por servidor.
WEB_API_SECRET=

# E-mail de contato para pedidos de privacidade (LGPD), exibido em /privacidade.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Admin (Auth.js v5 + Amazon Cognito) ---------------------------------------------
# Sem estas quatro variáveis, /admin mostra "autenticação não configurada".
# Gere AUTH_SECRET com: openssl rand -base64 32
AUTH_SECRET=
# App client do User Pool (com client secret; callback: {SITE_URL}/api/auth/callback/cognito)
AUTH_COGNITO_ID=
AUTH_COGNITO_SECRET=
# https://cognito-idp.sa-east-1.amazonaws.com/<user-pool-id>
AUTH_COGNITO_ISSUER=
# Opcional fora da Vercel: URL pública usada pelo Auth.js nos redirecionamentos.
# AUTH_URL=https://exemplo.com.br

# --- Analytics sem cookies (opcional; defina só um) ----------------------------------
# Plausible: domínio do site cadastrado no Plausible (e, se self-hosted, a URL do script).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Umami: ID do site e URL do script.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# Opcional: origem do OpenAPI para `pnpm gen:api` (arquivo ou URL).
# OPENAPI_SOURCE=../energia-api/openapi.json
